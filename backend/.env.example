DATABASE_URL="postgresql://quizoo_user:quizoo_pass@localhost:5432/quizoo?schema=public"
PORT=3001
NODE_ENV=development

# Подпись JWT (сгенерируйте длинную случайную строку)
JWT_SECRET="Eav5fpgkAVyLOAG6+m4bUsPRKclyvGxfk3SjLltcOjFFCAuoLdRTSYwCoe2ZJKSNZcZJewhSNYB1HXsryFrw2w=="

# Разрешённые origin для CORS (через запятую), должны совпадать с URL фронта
CORS_ORIGIN="http://localhost:3000"

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Можно оставить пустым для локального значения по умолчанию:
# http://localhost:${PORT}/api/auth/google/callback
GOOGLE_REDIRECT_URI=""

# Куда backend редиректит пользователя после Google callback
AUTH_FRONTEND_URL="http://localhost:3000"

# SMTP (Gmail)
# Для Gmail используйте app password (требуется 2FA), обычный пароль аккаунта не подойдет.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="QuizoO <no-reply@quizoo.local>"
