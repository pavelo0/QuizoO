# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Пусто = ${AUTH_FRONTEND_URL}/api/auth/google/callback
# Docker / HTTPS: https://localhost/api/auth/google/callback
GOOGLE_REDIRECT_URI=""

# Куда backend редиректит пользователя после Google callback
AUTH_FRONTEND_URL="https://localhost"

# SMTP (Gmail)
# Для Gmail используйте app password (требуется 2FA), обычный пароль аккаунта не подойдет.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="QuizoO <no-reply@quizoo.local>"
