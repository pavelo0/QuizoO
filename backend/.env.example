DATABASE_URL="postgresql://quizoo_user:quizoo_pass@localhost:5432/quizoo?schema=public"
PORT=3001
NODE_ENV=development

# Подпись JWT (сгенерируйте длинную случайную строку)
JWT_SECRET="Eav5fpgkAVyLOAG6+m4bUsPRKclyvGxfk3SjLltcOjFFCAuoLdRTSYwCoe2ZJKSNZcZJewhSNYB1HXsryFrw2w=="

# Разрешённые origin для CORS (через запятую)
