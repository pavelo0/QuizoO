POSTGRES_USER=quizoo_user
POSTGRES_PASSWORD=quizoo_pass
POSTGRES_DB=quizoo

JWT_SECRET=change_me_to_a_long_random_secret

CORS_ORIGIN=https://localhost,http://localhost
AUTH_FRONTEND_URL=https://localhost

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Пусто = https://localhost/api/auth/google/callback (через nginx)

# SMTP (Gmail)
# Use Gmail app password (2FA required). Regular account password will not work.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=QuizoO <no-reply@quizoo.local>
